# Development-only values. Change every secret before deployment.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-now
INFLUXDB_TOKEN=dev-super-secret-token-change-me
INFLUXDB_ORG=aiot
INFLUXDB_BUCKET=gas_monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now

# Simulator (mode 1): replays demo_data/demo_1hz.csv, one row per second
SIMULATOR_NODE_ID=virtual-gas-01
SIMULATOR_INTERVAL_SECONDS=1.0
SIMULATOR_LOOP=true
# Publish the CSV's CO / C2H4 columns as ground truth (reference for the dashboards, not a model input)
SIMULATOR_PUBLISH_GROUND_TRUTH=true
# Synthetic mode only (no CSV): one 90 s dataset-like gas episode every N events (0 disables)
SIMULATOR_LEAK_EVERY_EVENTS=420
DIRECT_OVERRIDE_SECONDS=30

# Edge model on the gateway: tabm (INT8, same blob as the ESP32) or ridge (synthetic-data model)
EDGE_MODEL=tabm
TABM_MEMBERS=32
TABM_INFER_EVERY_S=1
# Nodes that always run their own model; the gateway never predicts for them
EDGE_SKIP_NODES=esp32-edge-01

# Kitchen screen: empty follows whichever node streams; scripts/demo.ps1 esp32 pins esp32-edge-01
DEMO_NODE_ID=
